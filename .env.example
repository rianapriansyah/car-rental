VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Optional: canonical site URL for kuitansi QR verification links (defaults to the current browser origin).
# On Vercel, set all VITE_* in Project → Settings → Environment Variables (they are baked in at build time; redeploy after changes).
# Example: VITE_PUBLIC_SITE_URL=https://your-app.vercel.app or your custom domain (no trailing slash).
# VITE_PUBLIC_SITE_URL=https://mydomain.com

# Temporary: first Auth user becomes admin (see migration auth_first_user_admin). Remove after onboarding.
# VITE_SHOW_ADMIN_BOOTSTRAP=true
